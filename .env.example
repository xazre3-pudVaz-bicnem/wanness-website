# ===== わんness 環境変数 =====
# 本番URL（canonical / OGP / sitemap に使用）
NEXT_PUBLIC_SITE_URL=https://example.com

# 公式LINEのURL（未設定の場合、LINEボタンは電話・フォーム案内に切り替わります）
NEXT_PUBLIC_LINE_URL=

# お問い合わせフォームの送信先メールアドレス（未設定の場合、フォームはLINE・電話を案内します）
CONTACT_EMAIL=

# Resend APIキー（フォームのメール送信に使用。https://resend.com）
RESEND_API_KEY=

# Resend の送信元アドレス（ドメイン認証済みのアドレスを推奨。未設定時は onboarding@resend.dev）
CONTACT_FROM=
